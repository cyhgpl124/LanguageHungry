rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/knowledge/{collectionName}/items/{documentId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    match /users/{userId}/knowledge/files {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    match /users/{userId}/knowledge/files/categories/{categoryId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;

      match /items/{fileId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }
    }

    match /users/{userId}/chatRooms/{roomId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;

      match /messages/{messageId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }

      match /galleryImages/{imageId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }
    }

    match /users/{userId}/chatGalleryImages/{imageId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    match /users/{userId}/chatGalleryAlbums/{albumId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    match /users/{userId}/chatFriends/{friendId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }
  }
}
